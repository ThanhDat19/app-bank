{
  "realm": "bank-lab",
  "enabled": true,
  "displayName": "Bank Lab — Local Simulation",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "accessTokenLifespan": 300,
  "roles": {
    "client": {
      "bank-api": [
        {"name": "CUSTOMER", "description": "Simulation customer"},
        {"name": "OPERATOR", "description": "Simulation operations user"}
      ]
    }
  },
  "clients": [
    {
      "clientId": "bank-api",
      "enabled": true,
      "bearerOnly": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "bank-swagger",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": ["http://localhost:8080/swagger-ui/oauth2-redirect.html"],
      "webOrigins": ["http://localhost:8080"],
      "defaultClientScopes": ["basic"],
      "optionalClientScopes": [],
      "attributes": {"pkce.code.challenge.method": "S256"},
      "protocolMappers": [
        {
          "name": "bank-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "bank-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "bank-api-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "config": {
            "usermodel.clientRoleMapping.clientId": "bank-api",
            "claim.name": "resource_access.bank-api.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ]
}
